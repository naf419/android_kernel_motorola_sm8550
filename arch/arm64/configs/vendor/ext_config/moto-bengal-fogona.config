#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
CONFIG_FOGONA_DTB=y
CONFIG_I2C_CHARDEV=m
CONFIG_MOT_SENSOR_PRE_POWERUP=y
CONFIG_UFSFEATURE=y
CONFIG_UFSFEATURE3=y
CONFIG_UFSHID=y
CONFIG_UFSHID_POC=y
CONFIG_SCHED_MOTO_UNFAIR=m

# match stock fogona config
CONFIG_ARM64_AMU_EXTN=y
CONFIG_NETFILTER_XT_MATCH_L2TP=y
CONFIG_NET_VENDOR_EZCHIP=y
CONFIG_NET_VENDOR_HISILICON=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_NET_VENDOR_NETRONOME=y
CONFIG_NET_VENDOR_ROCKER=y
CONFIG_NET_VENDOR_SYNOPSYS=y
CONFIG_SERIO_SERPORT=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_NVMEM_SYSFS=y
CONFIG_NETWORK_FILESYSTEMS=y

# clk-qcom split lpass into a seperate kmod
CONFIG_SM_LPASS_AUDIOCC_KHAJE=m
